{
  "name": "fvgitry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n site,api -c blue,magenta \"vite\" \"npm run dev:api\"",
    "dev:site": "vite",
    "dev:api": "wrangler dev --config worker/wrangler.toml --port 8787",
    "dev:all": "npm run dev",
    "deploy:api": "wrangler deploy --config worker/wrangler.toml",
    "deploy:secrets": "node worker/upload-secrets.mjs",
    "deploy:site": "npm run build && wrangler pages deploy dist --project-name=scenepacksite",
    "deploy": "npm run deploy:api && npm run deploy:site",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "lucide-react": "^1.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "wrangler": "^4.54.0"
  }
}
