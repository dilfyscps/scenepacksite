# Local dev (.env) — leave empty, use npm run dev
VITE_STATS_API_URL=

# Production build (.env.production)
VITE_STATS_API_URL=https://scenepacks-stats.bzvelae.workers.dev

# --- Admin (Worker-side, NOT in Vite env) ---
# Local credentials: worker/.dev.vars
#   ADMIN_USERNAME=...
#   ADMIN_PASSWORD=...
#   TMDB_API_KEY=...   (free at https://www.themoviedb.org/settings/api)
# Live secrets:
#   wrangler secret put ADMIN_USERNAME --config worker/wrangler.toml
#   wrangler secret put ADMIN_PASSWORD --config worker/wrangler.toml
#   wrangler secret put TMDB_API_KEY --config worker/wrangler.toml
#
# Admin panel: /admin/login  (footer → Admin)
#
# --- Deploy (two parts) ---
#
# 1) SITE — dilfyscps.xyz via Git → Cloudflare Pages
#    Push to GitHub; Pages runs `npm run build` and publishes `dist/`.
#    Build uses `.env.production` below (committed) OR set the same var in
#    Cloudflare Dashboard → Pages → your project → Settings → Environment variables:
#      VITE_STATS_API_URL = https://scenepacks-stats.bzvelae.workers.dev
#    You do NOT need `npm run deploy:site` if Git is connected.
#
# 2) API — scenepacks-stats worker (profiles, packs, admin, stats)
#    After worker code changes:  npm run deploy:api
#    Admin login secrets (once, or when rotating passwords):
#      npm run deploy:secrets
#
# Optional manual Pages upload (only if not using Git):
#   npm run deploy:site
